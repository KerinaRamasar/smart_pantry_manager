<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:id="@+id/textFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textColor="@color/text_main"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/editName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name (e.g. Tomato)"
        android:inputType="textCapSentences"
        android:background="@drawable/bg_input_field"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_secondary" />

    <TextView
        android:id="@+id/errorName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error_delete"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g. 2)"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_input_field"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/errorQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error_delete"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (e.g. g, ml, unit)"
        android:inputType="text"
        android:background="@drawable/bg_input_field"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <EditText
        android:id="@+id/editExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry date - optional (yyyy-MM-dd)"
        android:inputType="date"
        android:background="@drawable/bg_input_field"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/errorExpiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/error_delete"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save"
        android:textColor="@color/background"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:layout_marginTop="24dp" />

</LinearLayout>